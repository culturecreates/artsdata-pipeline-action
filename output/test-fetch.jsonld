    ],
    "http://schema.org/url": [
      {
        "@id": "https://imperialtheatre.ca/event/lennie-gallants-innkeepers-christmas/38601APMJBSGHLBVKJDHHGBQTTKBBSMSJ/"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://imperialtheatre.ca/genid/313b9e46b67b3cf9"
      }
    ],
    "http://schema.org/organizer": [
