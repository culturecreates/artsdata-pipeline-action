.aspx?EventId=33201AJLRJQTMSPLGKHLNMPSPGHMNLTRH\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2027-05-10T16:00:00-03:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"Retro Film: Spaceballs\"\n    }\n}\n\n\n\n\n\t\n\t\t\n\t\n\n\t"
      }
