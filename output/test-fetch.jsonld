        "@language": "en",
        "@value": "\n\n\t\t\n\n\t\n\t\t\n\t\t\t\n\n\t\t\t\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Wed Dec 2, 2026 • 7:00pm\n\n  \n          Music\n    \n          Classical / Orchestra\n      \n\n  Event length: 70 minutes\n\n  \n\n\n      \n  \n    Buy tickets\n  \n\n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  Stadacona Band Holiday Tour\n        \n                  \n            $0 [limit of 6] //\nCelebrate the warmth and wonder of the holiday season with the Stadacona Band of the Royal Canadian Navy and acclaimed Nova Scotian singer-songwriter Terra Spencer. This festive concert brings together the rich sound of one of Canada's premier military bands with Terra's heartfelt storytelling, wit, and distinctive folk-inspired artistry. Featuring Christmas classics, locally inspired originals, and unique collaborative performances, this heartwarming concert celebrates the joy, wonder, and spirit of the season.\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Music      \n    \n          \n        Genre: Classical / Orchestra      \n    \n          \n        Event Length: 70 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/stadacona-band-holiday-tour/48401AVGNMMHRQVCLVRTRPKGHCJLGDVKR/#event-48401avgnmmhrqvclvrtrpkghcjlgdvkr\",\n    \"name\": \"Stadacona Band Holiday Tour\",\n    \"url\": \"https://imperialtheatre.ca/event/stadacona-band-holiday-tour/48401AVGNMMHRQVCLVRTRPKGHCJLGDVKR/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"$0 [limit of 6] // Celebrate the warmth and wonder of the holiday season with the Stadacona Band of the Royal Canadian Navy and acclaimed Nova Scotian singer-songwriter Terra Spencer. This festive concert brings together the rich sound of one of Canada's premier military bands with Terra's heartfelt storytelling, wit, and distinctive folk-inspired artistry. Featuring Christmas classics, locally inspired originals, and unique collaborative performances, this heartwarming concert celebrates the joy, wonder, and spirit of the season.\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/e89e9d59-af55-4b2f-8d3d-ae856d35c195.jpg\"\n    ],\n    \"startDate\": \"2026-12-02T15:00:00-04:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=48401AVGNMMHRQVCLVRTRPKGHCJLGDVKR\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2026-12-02T15:00:00-04:00\"\n    },\n    \"p