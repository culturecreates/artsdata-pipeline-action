    ],
    "http://schema.org/image": [
      {
        "@id": "https://system.spektrix.com/imperialtheatrenewbrunswick/files/860aab2d-5066-45d2-92a9-648b9a47d40c.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-03T15:30:00-04:00"
      }
