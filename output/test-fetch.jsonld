    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "SJTC: Spamalot"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "$65 Regular | $60 Senior | $35 Student // Don’t miss Spamalot! A laugh-out-loud musical quest for the Holy Grail, where logic is optional and danger is rarely taken seriously. From “flesh wounds” that aren’t quite as bad as they look to gloriously absurd misadventures at every turn, it’s a fast-paced, joyfully ridiculous night at the theatre you won’t want to miss."
      }
    ],
