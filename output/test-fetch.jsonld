        "@value": "\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Wed Jan 27, 2027 • 6:30pm\n\n  \n          Music\n    \n          Country\n      \n\n  Event length: 60 minutes\n\n      Admission $89.25\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  Tenille Townes VIP Add-On\n        \n                  \n            Tenille Townes: Time with Tenille VIP Experience - Add-On\nQuantity: 70 add-on\nIncludes:\nIntimate acoustic performance of 1-2 songs not being played during the show\nMeet & Greet and Personal Photo Opportunity with Tenille\nVIP-exclusive tour poster, autographed by Tenille\nEarly entry to the venue and access to merch shopping \n*Please note, VIP is general admission, and you will need to move to your designated seat for the performance*\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Music      \n    \n          \n        Genre: Country      \n    \n          \n        Event Length: 60 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/tenille-townes-vip-add-on/41401ASSQNDLHNVKJRVQSRBSHHNBDDDQS/#event-41401assqndlhnvkjrvqsrbshhnbdddqs\",\n    \"name\": \"Tenille Townes VIP Add-On\",\n    \"url\": \"https://imperialtheatre.ca/event/tenille-townes-vip-add-on/41401ASSQNDLHNVKJRVQSRBSHHNBDDDQS/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",