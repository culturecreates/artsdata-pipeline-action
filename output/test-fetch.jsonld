1874)\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/12b40d2b-0239-4062-aa32-5308e9c4f690.jpg\"\n    ],\n    \"startDate\": \"2027-06-02T16:30:00-03:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=48201AHQBKMVGJSTQGDDLBHBMNSLMGSVN\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2027-06-02T16:30:00-03:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"SNB: Of Words & Images\"\n    }\n}\n\n\n\n\n\t\n\t\t\n\t\n\n\t\n\t\n\n\n\n\t\t\n\t\n\n\n\n\t"
