    "https://schema.org/mainContentOfPage": [
      {
        "@language": "en",
        "@value": "\n\n\t\t\n\n\t\n\t\t\n\t\t\t\n\n\t\t\t\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Fri May 28, 2027 • 7:00pm\n\n  \n          Music\n    \n          Pop\n      \n\n  Event length: 90 minutes\n\n      Admission $55.00 | Admission $50.00\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  Melly Dunn Ultimate 80's Experience\n        \n                  \n            Orchestra Admission $55 || Balcony Admission $50 ||\nDust off your neon and leathers! Pull up your leg warmers. Get ready to relive the cult decade that screams nostalgia!\nMelly Dunn’s Ultimate 80’s brings you a world-class, high-energy experience packed with the biggest hits of the 1980’s. It’s a time machine featuring a powerhouse lead vocalist backed by a razor-sharp band. This show unleashes the signature sounds of Bonnie Tyler, ABBA, Michael Jackson, Eurythmics, Journey, Pat Benatar, Blondie, Madonna, Bon Jovi and many more.\nWith jaw-dropping vocal range, authentic 80’s attire, killer guitar solos, and non-stop energy, this nostalgic tribute guarantees a night you won’t forget. Tune up your vocal cords, because we wanna hear you singing and reminiscing like no one’s watching.\nBig voices. Iconic hits. One legendary night.\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Music      \n    \n          \n        Genre: Pop      \n    \n          \n        Event Length: 90 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/melly-dunn-ultimate-80s-experience/49201ADMHVCPDCGVCRJSKQMLVHNQNVVVH/#event-49201admhvcpdcgvcrjskqmlvhnqnvvvh\",\n    \"name\": \"Melly Dunn Ultimate 80's Experience\",\n    \"url\": \"https://imperialtheatre.ca/event/melly-dunn-ultimate-80s-experience/49201ADMHVCPDCGVCRJSKQMLVHNQNVVVH/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"Orchestra Admission $55 || Balcony Admission $50 || Dust off your neon and leathers! Pull up your leg warmers. Get ready to relive the cult decade that screams nostalgia! Melly Dunn’s Ultimate 80’s brings you a world-class, high-energy experience packed with the biggest hits of the 1980’s. It’s a time machine featuring a powerhouse lead vocalist backed by a razor-sharp band. This show unleashes the signature sounds of Bonnie Tyler, ABBA, Michael Jackson, Eurythmics, Journey, Pat Benatar, Blondie, Madonna, Bon Jovi and many more. With jaw-dropping vocal range, authentic 80’s attire, killer guitar solos, and non-stop energy, this nostalgic tribute guarantees a night you won’t forget. Tune up your vocal cords, because we wanna hear you singing and reminiscing like no one’s watching. Big voices. Iconic hits. One legendary night.\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/7e351bf1-0ced-4ec5-ba5c-e0887cdb462a.jpg\"\n    ],\n    \"startDate\": \"2027-05-28T16:00:00-03:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=49201ADMHVCPDCGVCRJSKQMLVHNQNVVVH\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2027-05-28T16:00:00-03:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"Melly Dunn Ultimate 80's Experience\"\n    }\n}\n\n\n\n\n\t\n\t\t\n\t\n\n\t\n\t\n\n\n\n\t\t\n\t\n\n\n\n\t"
