    "https://schema.org/mainContentOfPage": [
      {
        "@language": "en",
        "@value": "\n\n\t\t\n\n\t\n\t\t\n\t\t\t\n\n\t\t\t\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Mon Dec 14, 2026 • 7:30pm\n\n  \n          Comedy\n    \n          Stand Up\n      \n\n\n      Admission $60.00 | Admission $50.00\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n      \n      IT Member Event\n    \n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  The Debaters Live On Tour: 20th Anniversary Holiday Special\n        \n                  \n            $60 A Regular || $55 A Member // $50 B Regular || $45 B Member ||\n\"The Debaters have been entertaining Canadians on the airwaves for over 20 years! To celebrate all the great laughs and questionable facts from the past two decades we’re crossing the country with a holiday tour for all ye faithful fans and listeners. Joining host Steve Patterson on this hilarious sleigh ride are a couple of his favourite debating elves, Deborah Kimmett and Matt Wright, ready to deliver a delightful evening of stand-up comedy and two joke-filled debates in the format made famous on CBC Radio. Book your tickets now to avoid the holiday rush!\nThese special shows are just for live audiences and aren’t recorded for broadcast.\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Comedy      \n    \n          \n        Genre: Stand Up      \n    \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n      \n        \n          \n        Season Sponsor\n              \n    \n    \n          \n        Event Sponsor\n        \n                                        \n      \n      \n      \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/the-debaters-live-on-tour-20th-anniversary-holiday-special/38402AHVQSHJNGJDCVCGTLMGCKSVGPKPG/#event-38402ahvqshjngjdcvcgtlmgcksvgpkpg\",\n    \"name\": \"The Debaters Live On Tour: 20th Anniversary Holiday Special\",\n    \"url\": \"https://imperialtheatre.ca/event/the-debaters-live-on-tour-20th-anniversary-holiday-special/38402AHVQSHJNGJDCVCGTLMGCKSVGPKPG/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"$60 A Regular || $55 A Member // $50 B Regular || $45 B Member || \\\"The Debaters have been entertaining Canadians on the airwaves for over 20 years! To celebrate all the great laughs and questionable facts from the past two decades we’re crossing the country with a holiday tour for all ye faithful fans and listeners. Joining host Steve Patterson on this hilarious sleigh ride are a couple of his favourite debating elves, Deborah Kimmett and Matt Wright, ready to deliver a delightful evening of stand-up comedy and two joke-filled debates in the format made famous on CBC Radio. Book your tickets now to avoid the holiday rush! These special shows are just for live audiences and aren’t recorded for broadcast.\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/dacd7282-0912-47f1-8e30-279244fc48ae.jpg\"\n    ],\n    \"startDate\": \"2026-12-14T15:30:00-04:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=38402AHVQSHJNGJDCVCGTLMGCKSVGPKPG\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2026-12-14T15:30:00-04:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"The Debaters Live On Tour: 20th Anniversary Holiday Special\"\n    }\n}\n\n\n\n\n\t\n\t\t\n\t\n\n\t\n\t\n\n\n\n\t\t\n\t\n\n\n\n\t"
      }
