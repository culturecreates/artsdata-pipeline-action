    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Thu Dec 3, 2026 • 7:30pm\n\n  \n          Music\n    \n          Folk / Alt\n      \n\n  Event length: 90 minutes\n\n      Admission $50.00 | Admission $40.00\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n      \n      IT Member Event\n    \n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  Lennie Gallant's Innkeepers Christmas\n        \n                  \n            $50 A Regular || $45 A Member // $40 B Regular || $35 B Member ||\n\"Celebrate the season in style with Lennie Gallant and his exceptional band as\nthey bring their beloved Christmas concert to the stage! This festive fan favourite blends original holiday songs, heartfelt storytelling, and stunning large-\nscreen visuals for a truly immersive experience. As well as songs from his highly\nacclaimed original Christmas album, this year’s show will include new\ncompositions and some fabulous new arrangements to some Yuletide favourites!\nLennie and his band are spreading cheer with standout tracks like the stellar\nChristmas Day on Planet Earth, a song already finding its place among modern\nholiday classics. There are also fun numbers like I’m Gonna Have a Merry\nChristmas Even If It Kills Me, Love Reigns on Christmas Day, and of course, the\niconic show title number, The Innkeeper.\nAfter several years of sold-out shows across Eastern Canada, this year’s\nexpanded multimedia production promises to be the most magical yet. Joining\nLennie are an all-star lineup: Acadian standout Patricia Richard, virtuoso pianist\nJulien Robichaud, and gifted violinist Marie-Andrée Gaudet.\nTogether, they’ve been dazzling audiences all year—now they’re ready to fill\nyour holiday with warmth, wonder, laughter, and unforgettable music. Bring your\nChristmas spirit...and get ready to fall in love with the season all over again.\"\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Music      \n    \n          \n        Genre: Folk / Alt      \n    \n          \n        Event Length: 90 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n      \n        \n          \n        Season Sponsor\n              \n    \n    \n          \n        Event Sponsor\n        \n                                        \n      \n      \n      \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/lennie-gallants-innkeepers-christmas/38601APMJBSGHLBVKJDHHGBQTTKBBSMSJ/#event-38601apmjbsghlbvkjdhhgbqttkbbsmsj\",\n    \"name\": \"Lennie Gallant's Innkeepers Christmas\",\n    \"url\": \"https://imperialtheatre.ca/event/lennie-gallants-innkeepers-christmas/38601APMJBSGHLBVKJDHHGBQTTKBBSMSJ/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"$50 A Regular || $45 A Member // $40 B Regular || $35 B Member || \\\"Celebrate the season in style with Lennie Gallant and his exceptional band as they bring their beloved Christmas concert to the stage! This festive fan favourite blends original holiday songs, heartfelt storytelling, and stunning large- screen visuals for a truly immersive experience. As well as songs from his highly acclaimed original Christmas album, this year’s show will include new compositions and some fabulous new arrangements to some Yuletide favourites! Lennie and his band are spreading cheer with standout tracks like the stellar Christmas Day on Planet Earth, a song already finding its place among modern holiday classics. There are also fun numbers like I’m Gonna Have a Merry Christmas Even If It Kills Me, Love Reigns on Christmas Day, and of course, the iconic show title number, The Innkeeper. After several years of sold-out shows across Eastern Canada, this year’s expanded multimedia production promises to be the most magical yet. Joining Lennie are an all-star lineup: Acadian standout Patricia Richard, virtuoso pianist Julien Robichaud, and gifted violinist Marie-Andrée Gaudet. Together, they’ve been dazzling audiences all year—now they’re ready to fill your holiday with warmth, wonder, laughter, and unforgettable music. Bring your Christmas spirit...and get ready to fall in love with the season all over again.\\\"\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/860aab2d-5066-45d2-92a9-648b9a47d40c.jpg\"\n    ],\n    \"startDate\": \"2026-12-03T15:30:00-04:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=38601APMJBSGHLBVKJDHHGBQTTKBBSMSJ\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2026-12-03T15:30:00-04:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"Lennie Gallant's Innkeepers Christmas\"\n    }\n}\n\n\n\n\n\t\n\t\t\n\t\n\n\t"
