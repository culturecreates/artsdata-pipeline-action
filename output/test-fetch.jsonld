    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://imperialtheatre.ca/event/raine-maida-chantal-kreviazuk-im-going-to-break-your-heart-tour/30801ARPRRSKJDTQHHJTDRTPHSSSJNCJP/"
