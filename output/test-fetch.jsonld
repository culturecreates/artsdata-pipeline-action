      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://imperialtheatre.ca/event/lennie-gallants-innkeepers-christmas/38601APMJBSGHLBVKJDHHGBQTTKBBSMSJ/"
