    ],
    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Wed Oct 14, 2026 • 7:30pm\n\n  \n          Music\n    \n          Rock\n      \n\n  Event length: 120 minutes\n\n      Admission $75.00 | Admission $65.00\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n      \n      IT Member Event\n    \n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  The Sheepdogs\n        \n                  \n            Regular A $75.00 / Member A $70.00 | Regular B $65.00 / Member B $60.00 // Four-time JUNO Award winners The Sheepdogs hit the stage at the Imperial Theatre! Known for their soulful harmonies, dual-guitar swagger, and high-energy live shows, the Saskatoon rockers have built a global following with their retro rock sound, performing at festivals and arenas around the world. \n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Music      \n    \n          \n        Genre: Rock      \n    \n          \n        Event Length: 120 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n      \n        \n          \n        Season Sponsor\n              \n    \n    \n          \n        Event Sponsors\n        \n                                                              \n      \n      \n      \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/the-sheepdogs/17601ADSBKGQMMPTLRCMTNQVQJNSBPVNG/#event-17601adsbkgqmmptlrcmtnqvqjnsbpvng\",\n    \"name\": \"The Sheepdogs\",\n    \"url\": \"https://imperialtheatre.ca/event/the-sheepdogs/17601ADSBKGQMMPTLRCMTNQVQJNSBPVNG/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"Regular A $75.00 / Member A $70.00 | Regular B $65.00 / Member B $60.00 // Four-time JUNO Award winners The Sheepdogs hit the stage at the Imperial Theatre! Known for their soulful harmonies, dual-guitar swagger, and high-energy live shows, the Saskatoon rockers have built a global following with their retro rock sound, performing at festivals and arenas around the world.\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/2a50ef0b-ceac-4ff6-8d44-192582a633d5.jpg\"\n    ],\n    \"startDate\": \"2026-10-14T16:30:00-03:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=17601ADSBKGQMMPTLRCMTNQVQJNSBPVNG\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2026-10-14T16:30:00-03:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"The Sheepdogs\"\n    }\n}\n\n\n\n\n\t\n\t\t\n\t\n\n\t"
      }
    ]
