      {
        "@language": "en",
        "@value": "\n\n\t\t\n\n\t\n\t\t\n\t\t\t\n\n\t\t\t\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Wed Oct 21, 2026 • 7:30pm\n\n  \n          Music\n    \n          Rock\n      \n\n  Event length: 130 minutes\n\n      Admission $79.00 | Admission $69.00 | Admission $59.00 | Student $49.00\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  Relive the Music: 50's 60's and 70's Show\n        \n                  \n            Price Level One $79 || Price Level Two $69 || Price Level Three $59 || Student $49 || Groups of 8 or more get 25% off ||\n\"RELIVE THE MUSIC\" is now even better as we’ve cranked it up a notch by adding the biggest hits of 70s ROCK, DISCO & FUNK. We still keep the biggest, most popular hits of the 50s & 60s, but have added our favourite 70s Artists.  \n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Music      \n    \n          \n        Genre: Rock      \n    \n          \n        Event Length: 130 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/relive-the-music-50s-60s-and-70s-show/35201AQQRSLKMCNNBJNMJCGMJTGPJQHBV/#event-35201aqqrslkmcnnbjnmjcgmjtgpjqhbv\",\n    \"name\": \"Relive the Music: 50's 60's and 70's Show\",\n    \"url\": \"https://imperialtheatre.ca/event/relive-the-music-50s-60s-and-70s-show/35201AQQRSLKMCNNBJNMJCGMJTGPJQHBV/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"Price Level One $79 || Price Level Two $69 || Price Level Three $59 || Student $49 || Groups of 8 or more get 25% off || \\\"RELIVE THE MUSIC\\\" is now even better as we’ve cranked it up a notch by adding the biggest hits of 70s ROCK, DISCO & FUNK. We still keep the biggest, most popular hits of the 50s & 60s, but have added our favourite 70s Artists.\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/d6d4ec56-8675-401a-a701-7b334e45c6a3.jpg\"\n    ],\n    \"startDate\": \"2026-10-21T16:30:00-03:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=35201AQQRSLKMCNNBJNMJCGMJTGPJQHBV\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2026-10-21T16:30:00-03:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \