.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=35401APNVLPNRJRDCGRRCTSSJTSMNRNQD\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2027-04-04T11:00:00-03:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"NB Youth Orchestra: Live in Saint John\"\n    }\n}\n\n\n\n\n\t\n\t\t\n\t\n\n\t"
