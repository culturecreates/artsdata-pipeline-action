    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "TNB: To Every Thing There is a Season"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Adult $45 || Student $25.00 || Adapted by NB Playwright Ryan Griffith from Alistair MacLeod’s classic 1977 short story, To Every Thing There is a Season tells the story of four siblings who recall one Christmas, long ago, when their family changed forever. Set in Inverness County, Cape Breton, the show features traditional and original Celtic music, and the poetic language and haunting characters both Alistair and Ryan are celebrated for. Theatre New Brunswick’s first Christmas production in several years is a timeless love letter to Maritime families and holiday traditions."
      }
    ],
